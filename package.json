{
  "name": "dystopia2025-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "homepage": "https://www.dystopia2025.kr/",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/optimize-images.mjs",
    "build": "vite build && node scripts/prerender-meta.mjs",
    "prerender": "node scripts/prerender-meta.mjs",
    "optimize-images": "node scripts/optimize-images.mjs",
    "optimize-audio": "node scripts/optimize-audio.mjs",
    "predeploy": "npm run build",
    "deploy": "gh-pages --dotfiles -d dist -r git@github.com:hwangtab/dystopia2025.git",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "framer-motion": "^10.16.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^2.0.5",
    "react-icons": "^4.11.0",
    "react-router-dom": "^6.16.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.0.3",
    "autoprefixer": "^10.4.15",
    "eslint": "^8.45.0",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "gh-pages": "^6.3.0",
    "postcss": "^8.4.29",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.3.3",
    "terser": "^5.39.0",
    "vite": "^4.4.5",
    "vite-plugin-sitemap": "^0.7.1"
  }
